<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gamesHubRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CFEAFF">

    <!-- Background Image -->
    <ImageView
        android:id="@+id/ivHubBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_hub"
        tools:ignore="ContentDescription" />

    <!-- Color Wash Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#38CFEAFF" />

    <!-- TAB 1: GAMES VIEW -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollGamesTab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <!-- Banner Carousel Container -->
            <FrameLayout
                android:id="@+id/bannerContainer"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_banner_container"
                android:clipToOutline="true">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpBannerPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Dots indicator -->
                <LinearLayout
                    android:id="@+id/llBannerDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="10dp"
                    android:gravity="center"
                    android:orientation="horizontal" />
            </FrameLayout>

            <!-- 2-Column Game Card Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGameCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="20dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- TAB 2: LEADERBOARD VIEW -->
    <LinearLayout
        android:id="@+id/containerLeaderboardTab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:visibility="gone">

        <!-- Leaderboard Header Panel -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_leaderboard_header"
            android:paddingHorizontal="18dp"
            android:paddingVertical="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Leaderboard"
                    android:textColor="#0A3D68"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Top players across WhaleUp"
                    android:textColor="#A60A3D68"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_badge_accent"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="🏆 Weekly"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Leaderboard RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLeaderboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="100dp" />

    </LinearLayout>

    <!-- FLOATING BOTTOM NAVIGATION BAR -->
    <FrameLayout
        android:id="@+id/flBottomNav"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="10dp">

        <!-- Animated Active Pill -->
        <View
            android:id="@+id/viewActiveNavPill"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_nav_active_pill" />

        <!-- Tab Items Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Games Tab -->
            <LinearLayout
                android:id="@+id/tabGames"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivTabGamesIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_gamepad"
                    app:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/tvTabGamesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Games"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Leaderboard Tab -->
            <LinearLayout
                android:id="@+id/tabLeaderboard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivTabLeaderboardIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_leaderboard"
                    app:tint="#0A3D68" />

                <TextView
                    android:id="@+id/tvTabLeaderboardText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Leaderboard"
                    android:textColor="#0A3D68"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

    <!-- SKELETON / LOADING CONTAINER (Exact HubSkeleton Match) -->
    <FrameLayout
        android:id="@+id/flSkeletonContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CFEAFF"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <!-- Banner Skeleton -->
            <View
                android:id="@+id/skBanner"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_skeleton_banner" />

            <!-- 6 Grid Cards Skeleton -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:paddingHorizontal="12dp"
                android:paddingTop="10dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_skeleton_card" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_skeleton_card" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_skeleton_card" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_skeleton_card" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_skeleton_card" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_skeleton_card" />
            </GridLayout>
        </LinearLayout>

        <!-- Skeleton Bottom Navigation Bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_bottom_nav"
            android:elevation="10dp">

            <View
                android:layout_width="160dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_nav_active_pill"
                android:alpha="0.6" />
        </FrameLayout>
    </FrameLayout>

    <!-- ERROR CONTAINER -->
    <FrameLayout
        android:id="@+id/flErrorContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CFEAFF"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_whaleup_logo" />

            <TextView
                android:id="@+id/tvErrorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Connection Error"
                android:textColor="#0A3D68"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Failed to load catalog. Please check your internet connection."
                android:textColor="#A60A3D68"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="#1A6FD8"
                android:paddingHorizontal="32dp"
                android:paddingVertical="12dp"
                android:text="Retry"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </FrameLayout>

    <!-- OVERLAYS CONTAINER -->
    <FrameLayout
        android:id="@+id/flOverlaysContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="20dp"
        android:visibility="visible">

        <com.whaleup.gameshub.ui.overlay.DailyLoginOverlayView
            android:id="@+id/vDailyLoginOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.whaleup.gameshub.ui.overlay.GameWinOverlayView
            android:id="@+id/vGameWinOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

</FrameLayout>
