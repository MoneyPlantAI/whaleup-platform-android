<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ftueOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/ghFtueOverlayColor"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/ivIntersectBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.3"
        tools:src="@drawable/intersectBg" />

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="wrap_content"
        android:layout_height="57dp"
        android:layout_marginTop="80dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivFtueWhaleLogo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            tools:src="@drawable/whaleLogo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Playground"
            android:textColor="?attr/ghTextColorPrimary"
            android:textSize="30sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvFtueSubheading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Welcome to the Fun Zone"
        android:textColor="?attr/ghTextColorSecondary"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout" />

    <LinearLayout
        android:id="@+id/cardsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvFtueSubheading">

        <!-- Card 1 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_ftue_card"
            android:elevation="4dp"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:paddingLeft="12dp"
                android:layout_height="wrap_content"
                android:text="Play games\non WhaleUp"
                android:textColor="?attr/ghTextColorSecondary"
                android:textSize="20sp"
                android:lineSpacingExtra="8dp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ivPlayGames"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ivPlayGames"
                android:layout_width="110dp"
                android:layout_height="100dp"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@drawable/playGames" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Card 2 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_ftue_card"
            android:elevation="4dp"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:paddingLeft="12dp"
                android:layout_height="wrap_content"
                android:text="Challenge your\nbesties!"
                android:textColor="?attr/ghTextColorSecondary"
                android:textSize="20sp"
                android:lineSpacingExtra="8dp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ivChallengeFriends"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ivChallengeFriends"
                android:layout_width="100dp"
                android:layout_height="78dp"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@drawable/challengeFriends" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Card 3 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="@drawable/bg_ftue_card"
            android:elevation="4dp"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:paddingLeft="12dp"
                android:layout_height="wrap_content"
                android:text="More fun\ncoming soon!"
                android:textColor="?attr/ghTextColorSecondary"
                android:textSize="20sp"
                android:lineSpacingExtra="8dp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ivMoreFun"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ivMoreFun"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@drawable/moreFun" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <Button
        android:id="@+id/btnFtueContinue"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="100dp"
        android:background="@drawable/bg_start_playing_btn"
        android:text="Continue"
        android:textAllCaps="false"
        android:textColor="@color/text_white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:layout_editor_absoluteX="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
