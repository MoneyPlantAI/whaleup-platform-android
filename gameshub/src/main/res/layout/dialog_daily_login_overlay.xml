<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/flDailyLoginOverlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D1052442"
    android:clickable="true"
    android:focusable="true"
    android:padding="20dp"
    android:visibility="gone">

    <!-- Decorative Bubble Layer -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false">

        <View
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="-18dp"
            android:layout_marginTop="120dp"
            android:background="@drawable/bg_bubble_decor" />

        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="80dp"
            android:layout_marginEnd="34dp"
            android:background="@drawable/bg_bubble_decor" />

        <View
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-8dp"
            android:layout_marginBottom="120dp"
            android:background="@drawable/bg_bubble_decor" />

        <View
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="42dp"
            android:layout_marginBottom="80dp"
            android:background="@drawable/bg_bubble_decor" />
    </FrameLayout>

    <!-- Dialog Card Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:maxWidth="420dp"
        android:background="@drawable/bg_daily_login_card"
        android:paddingHorizontal="22dp"
        android:paddingVertical="24dp"
        android:elevation="18dp">

        <!-- Close Button -->
        <FrameLayout
            android:id="@+id/btnDailyLoginClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_close_btn"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="✕"
                android:textColor="#0A3D68"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Eyebrow Pill -->
            <TextView
                android:id="@+id/tvDailyLoginEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_eyebrow_pill"
                android:letterSpacing="0.12"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="DAILY REWARD"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Reward Stage -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="188dp"
                android:layout_marginTop="8dp">

                <!-- Outer Ring -->
                <FrameLayout
                    android:layout_width="156dp"
                    android:layout_height="156dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_ring_outer_blue">

                    <!-- Inner Ring -->
                    <FrameLayout
                        android:layout_width="122dp"
                        android:layout_height="122dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_ring_inner_blue"
                        android:elevation="4dp">

                        <ImageView
                            android:id="@+id/ivDailyLoginTreasure"
                            android:layout_width="104dp"
                            android:layout_height="104dp"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_coin_reward" />
                    </FrameLayout>
                </FrameLayout>

                <!-- Sparkles -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="48dp"
                    android:rotation="-12"
                    android:text="✦"
                    android:textColor="#F4B400"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="22dp"
                    android:layout_marginEnd="40dp"
                    android:rotation="12"
                    android:text="✦"
                    android:textColor="#F4B400"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Day Pill -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="1dp"
                    android:background="@drawable/bg_day_pill"
                    android:elevation="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_day_dot" />

                    <TextView
                        android:id="@+id/tvDailyLoginDayText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#0A3D68"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Day 1" />
                </LinearLayout>
            </FrameLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/tvDailyLoginTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="You Earned!"
                android:textColor="#0A3D68"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Coin Amount Row -->
            <LinearLayout
                android:id="@+id/llDailyLoginCoinRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivDailyLoginCoinIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_coin_reward" />

                <TextView
                    android:id="@+id/tvDailyLoginCoinAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#0A3D68"
                    android:textSize="38sp"
                    android:textStyle="bold"
                    tools:text="50" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="5dp"
                    android:layout_marginBottom="7dp"
                    android:text="coins"
                    android:textColor="#A60A3D68"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvDailyLoginSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Yayy, you earned for daily visit!"
                android:textColor="#AE0A3D68"
                android:textSize="14sp" />

            <!-- Claim CTA Button -->
            <FrameLayout
                android:id="@+id/btnDailyLoginClaim"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_btn_accent"
                android:clickable="true"
                android:elevation="5dp"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDailyLoginCtaText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Play &amp; earn"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDailyLoginCtaArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:text="›"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </FrameLayout>

</FrameLayout>
