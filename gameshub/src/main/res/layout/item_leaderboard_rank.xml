<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/flRankRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_marginBottom="8dp">

    <!-- Card Container -->
    <LinearLayout
        android:id="@+id/llRankItemRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_leaderboard_item_normal"
        android:gravity="center_vertical"
        android:minHeight="58dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <!-- Rank position number circle -->
        <TextView
            android:id="@+id/tvRankNumber"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:textColor="#0A3D68"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="1" />

        <!-- Avatar profile circle -->
        <TextView
            android:id="@+id/tvAvatarCircle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:textColor="#0A3D68"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="U" />

        <!-- User info column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUserId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#0A3D68"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="User_1234" />

            <TextView
                android:id="@+id/tvPlaytime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#A60A3D68"
                android:textSize="12sp"
                tools:text="12m 45s played" />
        </LinearLayout>

        <!-- Score & Coin Icon -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivCoinIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_coin_reward" />

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#0A3D68"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="1500" />
        </LinearLayout>

    </LinearLayout>

    <!-- Tilted Crown Emoji for 1st Place (Top-Right Overflow, -16dp relative to card top) -->
    <TextView
        android:id="@+id/tvCrown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="10dp"
        android:rotation="15.0"
        android:text="👑"
        android:textColor="#FFD700"
        android:textSize="28sp"
        android:translationZ="5dp"
        android:visibility="gone" />

</FrameLayout>
