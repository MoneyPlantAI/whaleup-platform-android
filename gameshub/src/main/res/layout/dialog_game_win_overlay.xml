<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/flGameWinOverlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D1052442"
    android:clickable="true"
    android:focusable="true"
    android:padding="20dp"
    android:visibility="gone">

    <!-- Confetti Layer -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false">

        <View
            android:layout_width="6dp"
            android:layout_height="14dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="40dp"
            android:layout_marginTop="100dp"
            android:background="#FED906"
            android:rotation="25" />

        <View
            android:layout_width="6dp"
            android:layout_height="14dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="90dp"
            android:layout_marginEnd="50dp"
            android:background="#FF7557"
            android:rotation="-32" />

        <View
            android:layout_width="6dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="60dp"
            android:layout_marginBottom="110dp"
            android:background="#53D18B"
            android:rotation="-18" />

        <View
            android:layout_width="6dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="35dp"
            android:layout_marginBottom="140dp"
            android:background="#9F79FF"
            android:rotation="38" />

        <View
            android:layout_width="6dp"
            android:layout_height="14dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="160dp"
            android:layout_marginEnd="90dp"
            android:background="#55B6F3"
            android:rotation="12" />
    </FrameLayout>

    <!-- Dialog Card Container -->
    <FrameLayout
        android:id="@+id/flGameWinCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:maxWidth="420dp"
        android:background="@drawable/bg_daily_login_card"
        android:paddingHorizontal="18dp"
        android:paddingTop="24dp"
        android:paddingBottom="22dp"
        android:elevation="18dp">

        <!-- Close Button -->
        <FrameLayout
            android:id="@+id/btnGameWinClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_close_btn"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="✕"
                android:textColor="#0A3D68"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Eyebrow Pill -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_eyebrow_pill"
                android:letterSpacing="0.12"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="VICTORY"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Trophy Stage -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="178dp"
                android:layout_marginTop="6dp">

                <!-- Outer Ring -->
                <FrameLayout
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_ring_outer_gold">

                    <!-- Inner Ring -->
                    <FrameLayout
                        android:layout_width="118dp"
                        android:layout_height="118dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_ring_inner_gold"
                        android:elevation="4dp">

                        <ImageView
                            android:id="@+id/ivGameWinRewardImage"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_coin_reward" />
                    </FrameLayout>
                </FrameLayout>

                <!-- Laurels -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="30dp"
                    android:rotation="-18"
                    android:text="❮"
                    android:textColor="#E6A400"
                    android:textSize="44sp"
                    android:textStyle="normal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="30dp"
                    android:rotation="18"
                    android:text="❯"
                    android:textColor="#E6A400"
                    android:textSize="44sp"
                    android:textStyle="normal" />

                <!-- Sparkles -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="50dp"
                    android:layout_marginTop="28dp"
                    android:text="✦"
                    android:textColor="#F4B400"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="48dp"
                    android:text="✦"
                    android:textColor="#F4B400"
                    android:textSize="23sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You earned"
                android:textColor="#0A3D68"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Coin Amount Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_coin_reward" />

                <TextView
                    android:id="@+id/tvGameWinCoinAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#0A3D68"
                    android:textSize="38sp"
                    android:textStyle="bold"
                    tools:text="100" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="5dp"
                    android:layout_marginBottom="7dp"
                    android:text="coins"
                    android:textColor="#A60A3D68"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvGameWinSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="18dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:textColor="#AE0A3D68"
                android:textSize="14sp"
                tools:text="Yayy, you earned for playing Ludo!" />

            <!-- Button Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Share Button -->
                <FrameLayout
                    android:id="@+id/btnGameWinShare"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="0.8"
                    android:background="@drawable/bg_btn_share"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:text="↗"
                            android:textColor="#0A3D68"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvGameWinShareText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Share"
                            android:textColor="#0A3D68"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Continue Button -->
                <FrameLayout
                    android:id="@+id/btnGameWinContinue"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1.35"
                    android:background="@drawable/bg_btn_accent"
                    android:clickable="true"
                    android:elevation="5dp"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Continue playing"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="›"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

</FrameLayout>
